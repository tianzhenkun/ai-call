# ==================================
# 智能外呼开发环境配置示例
# ==================================

ENVIRONMENT = "dev"

# 服务器配置
SERVER_HOST = "127.0.0.1"
SERVER_PORT = 19010

# 文档配置
DEBUG = True
TITLE = "LingChen AI Call - dev"
VERSION = "0.1.0"
SUMMARY = "接口汇总"
DOCS_URL = "/docs"
ROOT_PATH = "/ai-call-api/v1"
DESCRIPTION = "智能外呼独立后端基座"

# JWT 配置
JWT_ENABLE = False
SECRET_KEY = "change-me-in-local-env"

# 数据库配置
DATABASE_TYPE = "postgres"
DATABASE_HOST = "127.0.0.1"
DATABASE_PORT = 5432
DATABASE_USER = "postgres"
DATABASE_PASSWORD = "CHANGE_ME"
DATABASE_NAME = "lingchen_ai_call"
POOL_SIZE = 3
MAX_OVERFLOW = 2
POOL_TIMEOUT = 10

# Redis 配置
REDIS_ENABLE = True
REDIS_HOST = "127.0.0.1"
REDIS_PORT = 6379
REDIS_USER = ""
REDIS_PASSWORD = "CHANGE_ME"
REDIS_DB_NAME = 1

# 日志配置
LOGGER_LEVEL = "DEBUG"

# LiveKit / WebRTC 配置
LIVEKIT_URL = "ws://127.0.0.1:7880"
LIVEKIT_API_KEY = "CHANGE_ME_LIVEKIT_API_KEY"
LIVEKIT_API_SECRET = "CHANGE_ME_LIVEKIT_API_SECRET"

# 阿里云百炼统一配置
# Phase 00 默认 ASR / LLM / TTS / 通话后分析共用 DASHSCOPE_API_KEY。
DASHSCOPE_API_KEY = "CHANGE_ME_DASHSCOPE_API_KEY"
DASHSCOPE_REGION = "cn-beijing"
DASHSCOPE_BASE_URL = "https://dashscope.aliyuncs.com/compatible-mode/v1"
DASHSCOPE_WEBSOCKET_URL = "wss://dashscope.aliyuncs.com/api-ws/v1/inference"

# AI Provider 配置
ASR_PROVIDER = "aliyun-bailian"
ASR_MODEL = "fun-asr-realtime"
# 为空表示使用 DASHSCOPE_API_KEY；只有 ASR 使用独立密钥时才填写。
ASR_API_KEY = ""

LLM_PROVIDER = "aliyun-bailian"
LLM_BASE_URL = "https://dashscope.aliyuncs.com/compatible-mode/v1"
# 为空表示使用 DASHSCOPE_API_KEY；只有 LLM 使用独立密钥时才填写。
LLM_API_KEY = ""
LLM_MODEL = "qwen-plus"

TTS_PROVIDER = "aliyun-bailian"
TTS_MODEL = "cosyvoice-v3-flash"
# 为空表示使用 DASHSCOPE_API_KEY；只有 TTS 使用独立密钥时才填写。
TTS_API_KEY = ""
TTS_VOICE = "longanyang"

POST_ANALYSIS_MODEL = "qwen3.7-plus"
