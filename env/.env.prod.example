# ==================================
# 智能外呼生产环境配置示例
# ==================================

ENVIRONMENT = "prod"

# 服务器配置
SERVER_HOST = "0.0.0.0"
SERVER_PORT = 19010

# 文档配置
DEBUG = False
TITLE = "LingChen AI Call"
VERSION = "0.1.0"
SUMMARY = "接口汇总"
DOCS_URL = "/docs"
ROOT_PATH = "/ai-call-api/v1"
DESCRIPTION = "智能外呼独立后端基座"

# JWT 配置
JWT_ENABLE = True
SECRET_KEY = "CHANGE_ME"

# 数据库配置
DATABASE_TYPE = "postgres"
DATABASE_HOST = "postgres"
DATABASE_PORT = 5432
DATABASE_USER = "postgres"
DATABASE_PASSWORD = "CHANGE_ME"
DATABASE_NAME = "lingchen_ai_call"

# Redis 配置
REDIS_ENABLE = True
REDIS_HOST = "redis"
REDIS_PORT = 6379
REDIS_USER = ""
REDIS_PASSWORD = "CHANGE_ME"
REDIS_DB_NAME = 1

# 日志配置
LOGGER_LEVEL = "INFO"

# AI Call Phase A standalone 验证模式，生产默认关闭。
AI_CALL_STANDALONE_ENABLE = False

# LiveKit 录音。分轨录音默认开启，用于通话后 ASR 和完整聊天记录。
AI_CALL_RECORDING_ENABLED = True
AI_CALL_PARTICIPANT_RECORDING_ENABLED = True
AI_CALL_RECORDING_FORMAT = "MP3"
AI_CALL_PARTICIPANT_RECORDING_FORMAT = "OGG"
AI_CALL_RECORDING_OBJECT_PREFIX = "ai-call/recordings"
AI_CALL_EGRESS_TIMEOUT_SECONDS = 2.0
AI_CALL_EGRESS_STOP_TIMEOUT_SECONDS = 10.0
AI_CALL_RECORDING_VERIFY_DEADLINE_SECONDS = 900
AI_CALL_RECORDING_RECONCILE_ENABLED = True
AI_CALL_RECORDING_RECONCILE_INTERVAL_SECONDS = 5.0
AI_CALL_RECORDING_RECONCILE_BATCH_SIZE = 50
AI_CALL_OFFLINE_ASR_ENABLED = True
AI_CALL_OFFLINE_ASR_PROVIDER = "dashscope_paraformer"
AI_CALL_OFFLINE_ASR_MODEL = "paraformer-v2"
AI_CALL_OFFLINE_ASR_LANGUAGE_HINTS = "zh,en"
AI_CALL_OFFLINE_ASR_TIMEOUT_SECONDS = 300.0
AI_CALL_OFFLINE_ASR_POLL_INTERVAL_SECONDS = 2.0
AI_CALL_OFFLINE_ASR_QUEUE_MAX_SIZE = 1000
AI_CALL_BARGE_IN_ENABLED = True

# 转人工固定提示音。生产可替换为专业录制 wav，保持 mono / 16-bit PCM。
AI_CALL_HANDOFF_PROMPT_ENABLED = True
AI_CALL_HANDOFF_PROMPT_AUDIO_PATH = "static/ai-call/audio/handoff-waiting.wav"
AI_CALL_HANDOFF_PROMPT_TEXT = "正在为您接入人工，请稍等。"
AI_CALL_HANDOFF_TIMEOUT_SECONDS = 30
AI_CALL_HANDOFF_EXCEPTION_CLOSE_ENABLED = True
AI_CALL_HANDOFF_UNAVAILABLE_PROMPT_ENABLED = True
AI_CALL_HANDOFF_UNAVAILABLE_PROMPT_AUDIO_PATH = "static/ai-call/audio/handoff-unavailable.wav"
AI_CALL_HANDOFF_UNAVAILABLE_PROMPT_TEXT = "暂时未能接入人工，本次通话稍后将结束。"
AI_CALL_HANDOFF_AUTO_END_DELAY_SECONDS = 2.0
AI_CALL_HANDOFF_PROMPT_CONSTRAINT_ENABLED = True
AI_CALL_HANDOFF_AUTO_TRIGGER_ENABLED = True
AI_CALL_HANDOFF_CUSTOMER_INTENT_ENABLED = True
AI_CALL_HANDOFF_SYSTEM_RULE_ENABLED = False
AI_CALL_HANDOFF_INTENT_THRESHOLD = 0.8
AI_CALL_HANDOFF_INTENT_TIMEOUT_SECONDS = 1.0
AI_CALL_PROMPT_RESOLVE_TIMEOUT_SECONDS = 2.0
AI_CALL_DEBUG_PROMPT_OVERRIDE_ENABLED = False
