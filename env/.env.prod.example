# ==================================
# 智能外呼生产环境配置示例
# ==================================

ENVIRONMENT = "prod"

# 服务器配置
SERVER_HOST = "0.0.0.0"
SERVER_PORT = 19010

# 文档配置
DEBUG = False
TITLE = "LingChen AI Call"
VERSION = "0.1.0"
SUMMARY = "接口汇总"
DOCS_URL = "/docs"
ROOT_PATH = "/ai-call-api/v1"
DESCRIPTION = "智能外呼独立后端基座"

# JWT 配置
JWT_ENABLE = True
SECRET_KEY = "CHANGE_ME"

# 数据库配置
DATABASE_TYPE = "postgres"
DATABASE_HOST = "postgres"
DATABASE_PORT = 5432
DATABASE_USER = "postgres"
DATABASE_PASSWORD = "CHANGE_ME"
DATABASE_NAME = "lingchen_ai_call"

# Redis 配置
REDIS_ENABLE = True
REDIS_HOST = "redis"
REDIS_PORT = 6379
REDIS_USER = ""
REDIS_PASSWORD = "CHANGE_ME"
REDIS_DB_NAME = 1

# 日志配置
LOGGER_LEVEL = "INFO"

# AI Call Phase A standalone 验证模式，生产默认关闭。
AI_CALL_STANDALONE_ENABLE = False
