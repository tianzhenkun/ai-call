# 复制为 .env 后填写。此文件不得提交真实密钥。
ENVIRONMENT=dev
DEBUG=false
LOGGER_LEVEL=INFO
AI_CALL_STANDALONE_ENABLE=true
AI_CALL_PROCESS_ROLES=api,runtime,dispatcher,jobs,outbound
AI_CALL_OWNER_COMMAND_V1_ENTRIES=web,outbound
AI_CALL_RUNTIME_INSTANCE_ID=ai-call-118-01
AI_CALL_RUNTIME_PROVIDER_MODE=livekit
AI_CALL_RUNTIME_REAL_PROVIDER_ALLOWED=true
AI_CALL_OUTBOUND_EXECUTOR_ENABLED=true
AI_CALL_OUTBOUND_DIALER_MODE=sip
AI_CALL_OUTBOUND_LINPHONE_TEST_ENABLED=true
AI_CALL_OUTBOUND_LINPHONE_ALLOWED_CALLEE=19900001001
AI_CALL_SIP_OUTBOUND_ENABLED=true
AI_CALL_SIP_ALLOWED_CALLEE_PREFIXES=19900001001
SIP_PROXY=freeswitch:5089
SIP_CALLER_NUMBER=037123124845
SIP_SIGNALING_PORT=5089
SIP_RTP_RANGE=10000-20000
SIP_PUBLIC_IP=10.77.0.2
SIP_USE_EXTERNAL_IP=false

# 必须与 81 上签发现有网页登录 JWT 的 SECRET_KEY 相同；不复制主库。
SECRET_KEY=REPLACE_WITH_EXISTING_RECOv_JWT_SECRET
DATABASE_TYPE=postgres
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_USER=ai_call
DATABASE_PASSWORD=REPLACE_WITH_LONG_DATABASE_PASSWORD
DATABASE_NAME=ai_call
POSTGRES_USER=ai_call
POSTGRES_PASSWORD=REPLACE_WITH_LONG_DATABASE_PASSWORD
POSTGRES_DB=ai_call
REDIS_ENABLE=true
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB_NAME=1
REDIS_USER=
REDIS_PASSWORD=REPLACE_WITH_LONG_REDIS_PASSWORD

# API 服务端使用 Docker 内网地址；浏览器使用 81 的 TLS 反代地址。
LIVEKIT_URL=ws://livekit:7880
LIVEKIT_BROWSER_URL=wss://reach.lingchen-ai.com/livekit
LIVEKIT_API_KEY=REPLACE_WITH_LIVEKIT_API_KEY
LIVEKIT_API_SECRET=REPLACE_WITH_LONG_LIVEKIT_SECRET
LIVEKIT_BROWSER_TOKEN_TTL_SECONDS=600

# 必填：DashScope 实时模型凭据。
DASHSCOPE_API_KEY=REPLACE_WITH_DASHSCOPE_KEY

# 118 独立对象存储配置。须为 S3 兼容端点；Egress 与 API 共用同一桶。
AI_CALL_OSS_ENDPOINT=REPLACE_WITH_S3_ENDPOINT_WITHOUT_SCHEME
AI_CALL_OSS_ACCESS_KEY=REPLACE_WITH_OSS_ACCESS_KEY
AI_CALL_OSS_SECRET_KEY=REPLACE_WITH_OSS_SECRET_KEY
AI_CALL_OSS_BUCKET=REPLACE_WITH_OSS_BUCKET
AI_CALL_OSS_REGION=ap-shanghai
AI_CALL_OSS_PREFIX=ai-call
AI_CALL_OSS_HTTPS=true

# AI Call 知识库使用腾讯 COS；可与其他项目共用 Bucket，但必须使用独立前缀。
AI_CALL_KNOWLEDGE_COS_SECRET_ID=REPLACE_WITH_COS_SECRET_ID
AI_CALL_KNOWLEDGE_COS_SECRET_KEY=REPLACE_WITH_COS_SECRET_KEY
AI_CALL_KNOWLEDGE_COS_BUCKET=REPLACE_WITH_COS_BUCKET
AI_CALL_KNOWLEDGE_COS_REGION=ap-shanghai
AI_CALL_KNOWLEDGE_COS_PREFIX=ai-call
AI_CALL_KNOWLEDGE_WORKER_ENABLED=true

# Linphone 测试账号；只接受 WireGuard 中的 Mac 客户端。
FS_DEFAULT_PASSWORD=REPLACE_WITH_32_CHAR_ALNUM_PASSWORD
FS_EXTERNAL_IP=10.77.0.2
