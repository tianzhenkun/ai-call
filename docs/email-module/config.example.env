# 示例，不包含真实密钥；复制配置项到 REACH 现有本地/部署配置，不提交真实值。
REACH_EMAIL_LLM_BASE_URL=https://api.deepseek.com
REACH_EMAIL_LLM_MODEL=deepseek-v4-pro
REACH_EMAIL_LLM_API_KEY=
REACH_EMAIL_LLM_API_KEY_FILE=
# Fernet 稳定密钥。与平台 JWT、计费密钥、模型 Key 无关。
REACH_EMAIL_ENCRYPTION_KEY=
REACH_EMAIL_ENCRYPTION_KEY_FILE=
# 各项直接值与 _FILE 只配置一种。DATABASE_* 复用原有 REACH 数据库。
